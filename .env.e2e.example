# Playwright always starts a dedicated Portal dev server on this port.
# NOCOBASE_E2E_PORT=4173

# Keep this aligned with the Portal path being tested.
# NOCOBASE_PORTAL_BASE=/x/demo/

# Point this at the real NocoBase backend used by the test.
# NOCOBASE_E2E_API_URL=http://127.0.0.1:13000/api

NOCOBASE_E2E_ACCOUNT=nocobase
NOCOBASE_E2E_PASSWORD=
NOCOBASE_E2E_AUTHENTICATOR=basic
# NOCOBASE_E2E_ROLE=admin

# 定责跨企业隔离用例（e2e/dingze-isolation.spec.ts）：一个项目成员、一个其他企业的账号。
# DINGZE_E2E_PROJECT_ID=
# DINGZE_E2E_SPACE=
# DINGZE_E2E_MEMBER_ACCOUNT=
# DINGZE_E2E_MEMBER_PASSWORD=
# DINGZE_E2E_OUTSIDER_ACCOUNT=
# DINGZE_E2E_OUTSIDER_PASSWORD=
