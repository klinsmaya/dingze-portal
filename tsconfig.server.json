{
  "extends": "@nocobase/dev-config/tsconfig/server-library.json",
  "compilerOptions": {
    // Application configuration factories infer exports during the full TypeScript build.
    "isolatedDeclarations": false,
    // tsc-alias completes relative ESM paths after compilation.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist"
  },
  "tsc-alias": { "resolveFullPaths": true },
  // shared/ is isomorphic domain rules (catalog, lifecycle, validators). The nested
  // shared/tsconfig.json exists so ESLint's project service can find those files;
  // this include is what `pnpm build` / `tsc -p tsconfig.server.json` actually emit.
  "include": [
    "server/**/*.ts",
    "database/**/*.ts",
    "cli/**/*.ts",
    "shared/**/*.ts"
  ]
}
